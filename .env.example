# Telegram Bot Token (https://t.me/BotFather dan olingan token)
BOT_TOKEN=

# Groq API Key (https://console.groq.com/keys dan olinadi - Whisper va LLaMA uchun)
GROQ_API_KEY=

# Google Gemini API Key (ixtiyoriy, https://aistudio.google.com dan olinadi)
GEMINI_API_KEY=

# Google Cloud Platform API Key (ixtiyoriy)
GCP_API_KEY=

# Bot sozlamalari
BOT_NAME=Yuksalish Bot
MAX_HISTORY=10
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
DEFAULT_USER_ID=1453337970
